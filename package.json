{
  "name": "minks-pizza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:domain",
    "test:unit": "tsx --test \"src/**/*.test.ts\" && tsx scripts/test-pos-client.ts && tsx scripts/test-order-workflow.ts && tsx scripts/test-promotions.ts && tsx scripts/test-timeclock.ts",
    "test:domain": "tsx --env-file=.env.local scripts/test-pos-domain.ts",
    "e2e:loyalty": "tsx --env-file=.env.local --test --test-concurrency=1 scripts/e2e/loyalty.e2e.ts",
    "loyalty:audit": "tsx --env-file=.env.local scripts/loyalty-audit.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/run-migration.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
